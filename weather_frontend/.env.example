# Frontend environment variables for Simple Weather Viewer (Vite)
# The app determines API base in this order:
# 1) VITE_API_BASE
# 2) VITE_BACKEND_URL
# 3) '/api' (default)

# Example: public weather proxy/backend base URL (no trailing slash)
VITE_API_BASE=https://your-weather-backend.example.com
# VITE_BACKEND_URL=https://fallback-backend.example.com
